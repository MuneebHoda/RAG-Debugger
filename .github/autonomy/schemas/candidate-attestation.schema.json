{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "base_sha",
    "issue_number",
    "context_sha256",
    "manifest_sha256",
    "output_sha256",
    "authorization_sha256",
    "publication",
    "files",
    "file_count",
    "meaningful_lines"
  ],
  "properties": {
    "version": { "type": "integer", "const": 2 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "issue_number": { "type": "integer", "minimum": 1 },
    "context_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "base", "draft"],
      "properties": {
        "repository": {
          "type": "string",
          "const": "MuneebHoda/RAG-Debugger"
        },
        "branch": {
          "type": "string",
          "pattern": "^agent/issue-[1-9][0-9]*-[a-z0-9-]{1,52}$"
        },
        "base": { "type": "string", "const": "main" },
        "draft": { "type": "boolean", "const": true }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "operation", "mode", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240 },
          "operation": { "type": "string", "enum": ["upsert", "delete"] },
          "mode": { "type": "string", "enum": ["100644", "100755"] },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 5242880 },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "file_count": { "type": "integer", "minimum": 1, "maximum": 100 },
    "meaningful_lines": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  }
}
