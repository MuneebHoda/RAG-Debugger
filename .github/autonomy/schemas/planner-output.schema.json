{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "evidence",
          "scope",
          "non_goals",
          "implementation",
          "architecture",
          "acceptance_criteria",
          "tests",
          "security",
          "performance",
          "risks",
          "rollback",
          "labels"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 8, "maxLength": 100 },
          "summary": { "type": "string", "minLength": 40, "maxLength": 1200 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 8, "maxLength": 300 }
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "type": "string", "minLength": 8, "maxLength": 300 }
          },
          "non_goals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 4, "maxLength": 240 }
          },
          "implementation": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string", "minLength": 8, "maxLength": 400 }
          },
          "architecture": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1200
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string", "minLength": 8, "maxLength": 300 }
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string", "minLength": 8, "maxLength": 300 }
          },
          "security": { "type": "string", "minLength": 12, "maxLength": 1000 },
          "performance": {
            "type": "string",
            "minLength": 12,
            "maxLength": 1000
          },
          "risks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 8, "maxLength": 300 }
          },
          "rollback": { "type": "string", "minLength": 12, "maxLength": 800 },
          "labels": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3, "maxLength": 50 }
          }
        }
      }
    }
  }
}
