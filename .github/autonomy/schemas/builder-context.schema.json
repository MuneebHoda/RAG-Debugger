{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "base_sha",
    "trigger",
    "repository",
    "run_url",
    "authorized_labels",
    "bootstrap_authorization",
    "issue",
    "publication"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "trigger": {
      "type": "string",
      "enum": ["approval_label", "reconciliation", "bootstrap"]
    },
    "repository": {
      "type": "string",
      "const": "MuneebHoda/RAG-Debugger"
    },
    "run_url": {
      "type": "string",
      "pattern": "^https://github\\.com/MuneebHoda/RAG-Debugger/actions/runs/[0-9]+$"
    },
    "authorized_labels": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "agent/approved",
          "agent/sensitive-approved",
          "agent/large-approved"
        ]
      }
    },
    "bootstrap_authorization": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "issue_number",
        "policy_marker",
        "event_name",
        "ref",
        "before_sha",
        "base_sha",
        "sensitive_paths"
      ],
      "properties": {
        "version": { "type": "integer", "const": 1 },
        "id": { "type": "string", "minLength": 12, "maxLength": 100 },
        "issue_number": { "type": "integer", "minimum": 1 },
        "policy_marker": {
          "type": "string",
          "minLength": 12,
          "maxLength": 100
        },
        "event_name": { "type": "string", "const": "push" },
        "ref": { "type": "string", "const": "refs/heads/main" },
        "before_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sensitive_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "body", "labels"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "body": { "type": "string", "maxLength": 12000 },
        "labels": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "base", "draft"],
      "properties": {
        "branch": {
          "type": "string",
          "pattern": "^agent/issue-[1-9][0-9]*-[a-z0-9-]{1,52}$"
        },
        "base": { "type": "string", "const": "main" },
        "draft": { "type": "boolean", "const": true }
      }
    }
  }
}
