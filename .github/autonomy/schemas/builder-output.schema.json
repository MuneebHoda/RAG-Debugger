{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_number",
    "plan",
    "summary",
    "files_changed",
    "tests_added",
    "validation_commands",
    "documentation_updated",
    "risks",
    "rollback",
    "follow_ups",
    "atomicity",
    "generated_or_mechanical_paths",
    "test_exception"
  ],
  "properties": {
    "issue_number": { "type": "integer", "minimum": 1 },
    "plan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 8, "maxLength": 300 }
    },
    "summary": { "type": "string", "minLength": 30, "maxLength": 1600 },
    "files_changed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "tests_added": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 3, "maxLength": 300 }
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 3, "maxLength": 300 }
    },
    "documentation_updated": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 8, "maxLength": 300 }
    },
    "rollback": { "type": "string", "minLength": 12, "maxLength": 1000 },
    "follow_ups": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 3, "maxLength": 300 }
    },
    "atomicity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["justification", "testing", "rollback"],
      "properties": {
        "justification": { "type": "string", "maxLength": 1200 },
        "testing": { "type": "string", "maxLength": 1200 },
        "rollback": { "type": "string", "maxLength": 1200 }
      }
    },
    "generated_or_mechanical_paths": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "test_exception": { "type": "string", "maxLength": 1000 }
  }
}
